# Future generic environment categories only; no secrets are required by M0.1.
# RCQASYN_PROVIDER_API_KEY=
# RCQASYN_MODEL_NAME=
# RCQASYN_ENDPOINT=

# Copy to .env (gitignored) and fill in. Never commit .env.
# Study v3 provider keys, read from the environment by the provider adapters.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Meta Model API key for Muse Spark 1.3; confirm the exact variable name Meta's SDK expects.
META_API_KEY=
# Local Ollama (OpenAI-compatible endpoint); change the host if Ollama runs on another machine.
OLLAMA_BASE_URL=http://localhost:11434/v1
