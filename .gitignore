.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.pyright/
.env
.env.*
!.env.example
*.log

# Generated artifacts are local by default. Compact reports and manifests are
# collaboration-critical and therefore tracked automatically.
artifacts/*
!artifacts/.gitkeep
!artifacts/manifests/
!artifacts/manifests/**
!artifacts/reports/
!artifacts/reports/**
!artifacts/runs/
artifacts/runs/*

# These completed, expensive P0-v3/P1 runs are small enough for normal Git and
# are the canonical source artifacts behind the committed M1.5 reports.
!artifacts/runs/m1-p0-real-v3-Abalone19-gemma4-e4b-20260829/
!artifacts/runs/m1-p0-real-v3-Abalone19-gemma4-e4b-20260829/**
!artifacts/runs/m1-p0-real-v3-Ecoli4-gemma4-e4b-20260829/
!artifacts/runs/m1-p0-real-v3-Ecoli4-gemma4-e4b-20260829/**
!artifacts/runs/m1-p0-real-v3-page-blocks0-gemma4-e4b-20260829/
!artifacts/runs/m1-p0-real-v3-page-blocks0-gemma4-e4b-20260829/**
!artifacts/runs/m1-p1-real-Abalone19-gemma4-e4b-20260829/
!artifacts/runs/m1-p1-real-Abalone19-gemma4-e4b-20260829/**
!artifacts/runs/m1-p1-real-Ecoli4-gemma4-e4b-20260829/
!artifacts/runs/m1-p1-real-Ecoli4-gemma4-e4b-20260829/**
!artifacts/runs/m1-p1-real-page-blocks0-gemma4-e4b-20260829/
!artifacts/runs/m1-p1-real-page-blocks0-gemma4-e4b-20260829/**

# Archives and test scratch output remain local even under tracked parents.
artifacts/archives/
artifacts/test-tmp/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
literature/papers/*.pdf

# Raw dataset packages and model artifacts do not belong in normal Git.
*.zip
*.dat
*.tar
*.tar.gz
*.gguf
*.safetensors
*.ckpt
*.pth
*.pt
.ollama/
.DS_Store

# Superseded unapproved Phase-2 checkout-format preparation; retain locally only.
artifacts/reports/phase2/gate-a-v1/
artifacts/reports/phase2/gate-a-v2/

# Retain development and replay study outputs locally; commit the canonical run
# and the substantive replay comparison instead of duplicate evidence bundles.
artifacts/reports/empirical-v2/run-v1/
artifacts/reports/empirical-v2/replay-v1/

# Exploratory addendum v1 lives outside protected historical paths. Raw KEEL files and
# the large per-split evidence stay local (archived in artifacts/archives/, hash in
# addendum/v1/RELOCATION.json); compact results are tracked.
addendum/v1/data/raw/
addendum/v1/report/generation/
addendum/v1/report/predictions/
addendum/v1/report/replication/

addendum/v2/report/generation/
addendum/v2/report/predictions/
addendum/v2/report/replication/

# Study v3 local run outputs and fetched data
study/v3/runs/
study/v3/data/
